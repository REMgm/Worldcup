# --- Providers (§2/§3) ---
API_FOOTBALL_KEY=            # api-sports.io dashboard (primary, required for live data)
FOOTBALL_DATA_TOKEN=         # fallback only, football-data.org
# PROVIDER=football-data     # uncomment to switch to the fallback provider
# WORLD_CUP_SEASON=2026
# API_FOOTBALL_DAILY_BUDGET=100

# --- Supabase cache ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, cron ingest

# --- Cron protection (§4) ---
CRON_SECRET=                 # Vercel sends it as Authorization: Bearer on cron invocations
