# --- Providers (§2/§3) ---
# Default with no keys at all: the keyless ESPN feed (near real-time).
# Setting API_FOOTBALL_KEY switches the default to API-Football.
API_FOOTBALL_KEY=            # api-sports.io dashboard (spec-primary, optional)
FOOTBALL_DATA_TOKEN=         # fallback only, football-data.org
# PROVIDER=espn              # force one adapter: espn | api-football | football-data
# WORLD_CUP_SEASON=2026
# API_FOOTBALL_DAILY_BUDGET=100

# --- Supabase cache ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, cron ingest

# --- Cron protection (§4) ---
CRON_SECRET=                 # Vercel sends it as Authorization: Bearer on cron invocations
